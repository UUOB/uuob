<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The app installs newer versions of itself; nothing else. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- After the first update Android can install the next ones without asking again. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <receiver android:name="app.uuob.update.UpdateReceiver" android:exported="false" />
    </application>
</manifest>
