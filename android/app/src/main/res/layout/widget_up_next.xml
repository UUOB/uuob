<?xml version="1.0" encoding="utf-8"?>
<!-- The "Up next" widget (UpNext.kt): the timeline, drawn as one picture,
     and over it a tap area per band (filled in from code). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/timeline_day"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/up_next"
        android:scaleType="fitXY"
        android:visibility="@integer/widget_day" />

    <ImageView
        android:id="@+id/timeline_night"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/up_next"
        android:scaleType="fitXY"
        android:visibility="@integer/widget_night" />

    <LinearLayout
        android:id="@+id/slots"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" />
</FrameLayout>
